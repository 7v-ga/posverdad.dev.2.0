#############################
# Global ignores (monorepo)
#############################

# Node / Next.js / Turbo
node_modules/
.pnp/
.pnp.js
.next/
.next-turbo/
.turbo/
dist/
build/
out/

# Environment files
.env
.env.*
!.env.example

# Logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
turbo.log
*.log

# OS & Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

###########################################
# Frontend (apps/web)
###########################################

apps/web/.next/
apps/web/.turbo/
apps/web/.eslintcache
apps/web/node_modules/
apps/web/tsconfig.tsbuildinfo
apps/web/build/
apps/web/out/

# TypeScript build info
tsconfig.tsbuildinfo

###########################################
# Backend (apps/api — Python/FastAPI)
###########################################

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/

# MyPy / Pyright / Lint caches
.mypy_cache/
.pyrightcache/
.pytest_cache/

# Python packaging
*.egg-info/
*.egg
build/
dist/

###########################################
# Scraper (scrapy_project)
###########################################

scrapy_project/.scrapy/
scrapy_project/.cache/
scrapy_project/__pycache__/
scrapy_project/logs/
scrapy_project/output/

###########################################
# Database / Local state
###########################################

# Local DB dumps
*.sqlite3
*.db

# Temporary export files
*.csv
*.tmp

###########################################
# Project-specific generated files
###########################################

# Artefactos generados por el pipeline NLP
logs/
*.log

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

###########################################
# Allowlist: things we DO want to commit
###########################################
!.gitkeep
.coverage
